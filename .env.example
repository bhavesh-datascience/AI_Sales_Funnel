# Groq (AI drafting)
GROQ_API_KEY=

# Gmail (used by "Send Email")
# Your Gmail / Google Workspace address that emails are sent from
GMAIL_ADDRESS=
# 16-character App Password, NOT your normal password.
# Turn on 2-Step Verification, then create one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Zeal Interactive Service
# Optional: where replies go (defaults to GMAIL_ADDRESS)
EMAIL_REPLY_TO=
# Opt-out line added to the bottom of every email
EMAIL_FOOTER=If you'd prefer not to receive emails from us, just reply with "unsubscribe".

# Anti-spam throttling
# Minimum seconds between two emails
SEND_INTERVAL_SECONDS=20
# Random extra seconds (0..N) added to each gap when using Send All
SEND_JITTER_SECONDS=10
# Max emails per day (Gmail's hard limit is ~500 for personal accounts, 2000 for Workspace)
DAILY_SEND_LIMIT=400

# App login (change these!)
APP_USERNAME=zeal
APP_PASSWORD=zeal
# Random string that signs login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Gmail SMTP port: 465 (SSL, default) or 587 (STARTTLS)
SMTP_PORT=465
